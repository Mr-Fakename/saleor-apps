# ============================================================================
# Saleor API Configuration
# ============================================================================

# URL of Saleor GraphQL API
# Local development (Docker): http://api:8000/graphql/
# Local development (host): http://localhost:8000/graphql/
# Production: https://your-saleor-instance.com/graphql/
NEXT_PUBLIC_SALEOR_API_URL=http://localhost:8000/graphql/

# Slug of the channel to use for the app
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel

# ============================================================================
# App URL Configuration
# ============================================================================

# APP_API_BASE_URL: How Saleor (running in Docker) reaches this app
# - Docker: http://checkout-app:3001 (use service name)
# - Host: http://host.docker.internal:3001
# - Tunnel: https://your-tunnel-url.ngrok.io
# - Production: https://checkout-app.yourdomain.com
APP_API_BASE_URL=

# APP_IFRAME_BASE_URL: How Dashboard (browser) reaches this app
# - Local: http://localhost:3001
# - Tunnel: https://your-tunnel-url.ngrok.io
# - Production: https://checkout-app.yourdomain.com
APP_IFRAME_BASE_URL=

# ============================================================================
# APL (Auth Persistence Layer) Configuration
# ============================================================================

# APL type: 'file' for development, 'upstash' for production
APL=file

# Upstash Redis configuration (only needed if APL=upstash)
# Get these from https://upstash.com after creating a Redis database
# UPSTASH_URL=
# UPSTASH_TOKEN=

# DynamoDB (only needed if APL=dynamodb)
# DYNAMODB_MAIN_TABLE_NAME=checkout-prices-main-table
# AWS_REGION=eu-central-1
# AWS_ENDPOINT_URL=http://dynamodb:8001

# Create the DynamoDB table at server start when it is missing
# (src/instrumentation.ts — idempotent, logs and continues on failure).
# Replaces the removed /api/setup-db route. Default: off.
INIT_DYNAMODB_ON_STARTUP=false

# ============================================================================
# Public API security and business rules (read at runtime)
# ============================================================================

# Browser origins allowed to call the API routes cross-origin: comma-separated
# bare origins, no "*". The storefront calls /api/payment-fee FROM THE BROWSER,
# so production must list every shop origin, or the PayPal fee cannot be applied.
# Unset/empty = every cross-origin browser call gets 403. Server-to-server calls
# (no Origin header) and this app's own pages are not affected.
#   dess production: https://dess-equipement.com,https://www.dess-equipement.com
ALLOWED_ORIGINS=http://localhost:3000

# Service variant used for the PayPal fee line (required to apply the fee).
PAYMENT_FEE_VARIANT_ID=

# PayPal fee rate in percent of the checkout's fee-exclusive total. The app
# computes the fee amount itself and ignores any amount the caller sends.
# Keep equal to the storefront's integrations.paymentFee.ratePercent (there it
# only drives the label and the pre-apply estimate). Default 1.5; an invalid
# value makes fee application fail with 500 (fail closed).
PAYMENT_FEE_RATE_PERCENT=1.5

# Configured cables (/api/add-configured-cable), enforced server-side.
# Length bounds in cm (defaults match the dess storefront's
# features.cableConfigurator.limits) and the only product whose variants may be
# sold as configured cables.
CABLE_MIN_LENGTH_CM=10
CABLE_MAX_LENGTH_CM=5000
CABLE_PRODUCT_SLUG=cable-custom

# ============================================================================
# Docker-specific Configuration (when running in Docker)
# ============================================================================

# Default channel for Docker deployment
DEFAULT_CHANNEL=default-channel

# Saleor API URL for Docker (use service name)
SALEOR_API_URL=http://api:8000/graphql/
